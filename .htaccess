# Apache/LiteSpeed rules for the document root.
#
# Hostinger serves this repository straight out of public_html, which means
# every file the project needs in order to be BUILT is also a file the browser
# can ask for. Most are harmless; the SQLite database is not — with no DB_*
# environment set, config.php falls back to sqlite and nmiet.db IS the live
# database. It was downloadable in full until this file existed.
#
# Denying it costs nothing: PHP opens it from disk, not over HTTP.

<IfModule mod_authz_core.c>
    # data, and anything holding credentials or infrastructure
    <FilesMatch "\.(db|db-shm|db-wal|sqlite|sqlite3|env|keystore|jks|log)$">
        Require all denied
    </FilesMatch>

    # how the project is built and deployed — of no use to a visitor
    <FilesMatch "\.(ya?ml|conf|md|py|lock|dist|sh|bat|ps1)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(Dockerfile|.+\.Dockerfile|Procfile|composer\.json|router\.php|manage\.py)$">
        Require all denied
    </FilesMatch>

    # every dotfile except .well-known, which Chrome fetches to verify that the
    # Android app owns this domain — deny that and the app stops opening links
    <FilesMatch "^\.(?!well-known)">
        Require all denied
    </FilesMatch>
</IfModule>

# directories that exist for the build, not for the browser
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(vendor|tools|android|\.git|\.claude)/ - [F,L]
</IfModule>

# the app's own files must never be served stale after a deploy
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|webmanifest)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>

    # ---- security headers ----
    # Applied to every response ("always", so error pages carry them too).
    # Deliberately conservative: no content Content-Security-Policy, because a
    # strict one would have to enumerate every inline script, style and font the
    # app uses and one omission is a blank page. What is here cannot break a
    # page that renders today — it only forbids things the app never does.

    # The page is never meant to sit inside a frame on another site; both lines
    # say so, the modern one and the one older browsers read. This is the
    # clickjacking defence.
    Header always set Content-Security-Policy "frame-ancestors 'self'"
    Header always set X-Frame-Options "SAMEORIGIN"

    # A response labelled text/css is CSS; the browser may not second-guess a
    # declared type and run it as something else.
    Header always set X-Content-Type-Options "nosniff"

    # A link clicked out to the attendance portal carries the origin, not the
    # full path a student was looking at.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Features the CMS does not use are switched off, so a script that tried
    # would be refused by the browser rather than prompting somebody.
    Header always set Permissions-Policy "geolocation=(), microphone=(), payment=()"

    # The site already redirects http to https; this tells the browser to stop
    # trying http at all for six months. No includeSubDomains and no preload on
    # purpose — those are hard to walk back if a subdomain is ever served over
    # plain http, and this is reversible.
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
