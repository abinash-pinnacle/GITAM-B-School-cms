{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gitam-cms",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-S", "0.0.0.0:5500", "router.php"],
      "port": 5500,
      "autoPort": true
    },
    {
      "name": "gitam-cms-python",
      "runtimeExecutable": "python",
      "runtimeArgs": ["server.py"],
      "port": 5500,
      "autoPort": true
    },
    {
      "name": "gitam-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5502"],
      "port": 5502,
      "autoPort": true
    },
    {
      "name": "gitam-cms-docker",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "run", "--rm", "-p", "5501:5501",
        "-v", "${PWD}:/app", "-w", "/app",
        "php:8.3-cli", "php", "-S", "0.0.0.0:5501", "router.php"
      ],
      "port": 5501
    }
  ]
}
