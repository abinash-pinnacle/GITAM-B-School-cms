# Apache (XAMPP / cPanel): send every /api/... request to index.php.
# No RewriteBase, so this also works when the app lives in a subfolder.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# API responses are always live data
<IfModule mod_headers.c>
    Header set Cache-Control "no-store"
</IfModule>
